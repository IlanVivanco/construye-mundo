# Copy to .env and fill in (or run `npm run setup`, which writes it for you). .env is gitignored: never commit it,
# the GitHub repo is public.
# Create an application password in WP Admin → Users → Profile → Application Passwords.
WP_SITE_URL=https://construyemundo.org
WP_USER=claude
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
# Optional: the site's MCP endpoint, if it isn't Novamira's default.
# WP_MCP_PATH=/wp-json/mcp/novamira

# SSH to the shared host (read-only inspection, DB dumps for the local DDEV clone).
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY=~/.ssh/construye-mundo
# Absolute path of the WordPress root on the server.
SSH_WP_PATH=
